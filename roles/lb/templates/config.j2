{% if groups['master'] | length == 1 %}
    {% set apiserver = groups['master'][0] + ':' + '6443' %}
{% elif groups['master'] | length > 1 %}
    {% set apiserver = vip + ':' + '16443' %}
{% endif %}

apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: {{ lookup('pipe', 'base64 -w 0 ' + k8s_work_dir + '/ssl/ca.pem') }}
    server: https://{{ apiserver }}
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    user: admin
  name: default
current-context: default
kind: Config
preferences: {}
users:
- name: admin
  user:
    client-certificate-data: {{ lookup('pipe', 'base64 -w 0 ' + k8s_work_dir + '/ssl/admin.pem') }}
    client-key-data: {{ lookup('pipe', 'base64 -w 0 ' + k8s_work_dir + '/ssl/admin-key.pem') }}